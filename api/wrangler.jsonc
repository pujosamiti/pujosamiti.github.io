{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pujosamiti-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pujosamiti",
      "database_id": "ecdf8218-2679-4866-abde-57d405d5efb2",
      "migrations_dir": "drizzle"
    }
  ],
  // Media uploads (Uma article images) need R2. To switch them on: enable R2
  // in the Cloudflare dashboard, run `npx wrangler r2 bucket create
  // pujosamiti-files`, then uncomment the line below and redeploy. Until then
  // the upload routes answer 503 and article art ships in web/public/uma-media.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "pujosamiti-files" }],
  // Public headcount links (/api/public/bhog/headcount): a per-IP cap, so the
  // ~24 million codes can't be walked by brute force. A family loading and
  // saving its form uses a handful of requests; 60 leaves room for the many
  // phones behind one carrier IP (Jio/Airtel CGNAT) or a society's Wi-Fi
  // opening the link in the same minute it lands in the WhatsApp group.
  "ratelimits": [
    {
      "name": "HEADCOUNT_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    // Public, non-secret config. Secrets go in .dev.vars locally and
    // `wrangler secret put` in production — see .dev.vars.example.
    // Local dev overrides this via WEB_ORIGIN in .dev.vars (CORS + auth trusted origin).
    "WEB_ORIGIN": "https://pujosamiti.github.io"
  }
}
