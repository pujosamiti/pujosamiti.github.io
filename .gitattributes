# Normalize all text files to LF in the repo and on checkout.
# Without this, Git for Windows (core.autocrlf=true by default) checks files
# out with CRLF, breaking parity with .editorconfig and macOS checkouts.
* text=auto eol=lf

# Binary assets — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
